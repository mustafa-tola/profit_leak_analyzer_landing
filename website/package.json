{
  "name": "profit-leak-analyzer",
  "version": "0.0.1",
  "private": true,
  "description": "Academic prototype of a COD cost and settlement analytics dashboard.",
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "npx vite build",
    "build:api": "node scripts/build-api.mjs",
    "build:all": "npm run build && npm run build:api",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "preview": "npx vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:manual": "vite-node scripts/phase1-manual-check.ts",
    "api:dev": "vite-node scripts/api-server.ts",
    "api:start": "node dist-api/server.mjs",
    "api:smoke": "vite-node scripts/phase2-api-smoke.ts",
    "api:smoke:phase3": "vite-node scripts/phase3-api-smoke.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@clerk/backend": "^3.27.0",
    "@clerk/clerk-react": "^5.61.11",
    "@emotion/react": "^11.13.3",
    "@prisma/client": "^6.19.3",
    "framer-motion": "^11.5.4",
    "lucide-react": "0.522.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.30.2",
    "recharts": "^2.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "10.6.1",
    "esbuild": "^0.21.5",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "postcss": "8.5.31",
    "prisma": "^6.19.3",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.4",
    "vite": "5.4.21",
    "vitest": "^2.1.9"
  }
