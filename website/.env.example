# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/profit_leak_analyzer?schema=public"

# Clerk backend authentication
CLERK_SECRET_KEY="sk_test_replace_me"
# Comma-separated frontend origins allowed to present Clerk tokens.
CLERK_AUTHORIZED_PARTIES="http://localhost:5173"
# Which verified Clerk claim becomes the seller_id used in uploaded CSVs:
# org_slug (recommended), org_id, or sub. The selected value (case-insensitive)
# must match the seller_id column in the uploaded CSVs.
CLERK_SELLER_CLAIM="org_slug"

# API server
HOST=127.0.0.1
PORT=8787
# Comma-separated browser origins allowed to call the API.
PLA_CORS_ORIGINS="http://localhost:5173"

# Development only: trust the x-seller-id header. Never enable in production.
# PLA_DEV_HEADER_AUTH="1"

# Persistence selection. Defaults to prisma when DATABASE_URL is set, otherwise
# memory. Use PLA_REPOSITORY=memory for the Phase 2 smoke check without Postgres.
# PLA_REPOSITORY="prisma"

# Vite frontend (publishable key is browser-exposed by design)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
VITE_API_URL="http://127.0.0.1:8787"
